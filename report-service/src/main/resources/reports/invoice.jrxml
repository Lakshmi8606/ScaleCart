<?xml version="1.0" encoding="UTF-8"?>
<jasperReport
        xmlns="http://jasperreports.sourceforge.net/jasperreports"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
        name="invoice"
        pageWidth="595"
        pageHeight="842"
        columnWidth="555"
        leftMargin="20"
        rightMargin="20"
        topMargin="20"
        bottomMargin="20">

    <!-- Parameters: values passed in from Java code -->
    <parameter name="orderId" class="java.lang.Long"/>
    <parameter name="userId" class="java.lang.Long"/>
    <parameter name="orderDate" class="java.lang.String"/>
    <parameter name="shippingAddress" class="java.lang.String"/>
    <parameter name="totalAmount" class="java.math.BigDecimal"/>
    <parameter name="invoiceNumber" class="java.lang.String"/>

    <!-- Fields: columns from the data source -->
    <field name="productName" class="java.lang.String"/>
    <field name="quantity" class="java.lang.Integer"/>
    <field name="price" class="java.math.BigDecimal"/>
    <field name="lineTotal" class="java.math.BigDecimal"/>


    <!-- ====================================================== -->
    <!-- TITLE: Order details                                   -->
    <!-- ====================================================== -->

    <title>
        <band height="80">

            <staticText>
                <reportElement x="0" y="10" width="100" height="20"/>
                <textElement>
                    <font isBold="true"/>
                </textElement>
                <text><![CDATA[Order ID:]]></text>
            </staticText>

            <textField>
                <reportElement x="110" y="10" width="200" height="20"/>
                <textFieldExpression><![CDATA[$P{orderId}]]></textFieldExpression>
            </textField>

            <staticText>
                <reportElement x="0" y="35" width="100" height="20"/>
                <textElement>
                    <font isBold="true"/>
                </textElement>
                <text><![CDATA[Ship To:]]></text>
            </staticText>

            <textField>
                <reportElement x="110" y="35" width="400" height="20"/>
                <textFieldExpression><![CDATA[$P{shippingAddress}]]></textFieldExpression>
            </textField>

        </band>
    </title>


    <!-- ====================================================== -->
    <!-- PAGE HEADER: ScaleCart + Invoice information           -->
    <!-- ====================================================== -->

    <pageHeader>
        <band height="100">

            <!-- Company name -->
            <staticText>
                <reportElement x="0" y="0" width="300" height="40"/>
                <textElement>
                    <font size="24" isBold="true"/>
                </textElement>
                <text><![CDATA[ScaleCart]]></text>
            </staticText>

            <!-- INVOICE label -->
            <staticText>
                <reportElement x="400" y="0" width="155" height="40"/>
                <textElement textAlignment="Right">
                    <font size="20" isBold="true"/>
                </textElement>
                <text><![CDATA[INVOICE]]></text>
            </staticText>

            <!-- Invoice number -->
            <textField>
                <reportElement x="300" y="45" width="255" height="20"/>
                <textElement textAlignment="Right"/>
                <textFieldExpression>
                    <![CDATA["Invoice #: " + $P{invoiceNumber}]]>
                </textFieldExpression>
            </textField>

            <!-- Order date -->
            <textField>
                <reportElement x="300" y="65" width="255" height="20"/>
                <textElement textAlignment="Right"/>
                <textFieldExpression>
                    <![CDATA["Date: " + $P{orderDate}]]>
                </textFieldExpression>
            </textField>

            <!-- Horizontal line -->
            <line>
                <reportElement x="0" y="95" width="555" height="1"/>
                <graphicElement>
                    <pen lineWidth="2.0"/>
                </graphicElement>
            </line>

        </band>
    </pageHeader>


    <!-- ====================================================== -->
    <!-- COLUMN HEADER: Product / Qty / Price / Total           -->
    <!-- ====================================================== -->

    <columnHeader>
        <band height="30">

            <!-- Dark background -->
            <rectangle>
                <reportElement
                        x="0"
                        y="0"
                        width="555"
                        height="30"
                        backcolor="#2C3E50"/>
                <graphicElement>
                    <pen lineWidth="0"/>
                </graphicElement>
            </rectangle>

            <!-- Product -->
            <staticText>
                <reportElement
                        x="5"
                        y="5"
                        width="250"
                        height="20"
                        forecolor="#FFFFFF"/>
                <textElement>
                    <font isBold="true"/>
                </textElement>
                <text><![CDATA[Product]]></text>
            </staticText>

            <!-- Quantity -->
            <staticText>
                <reportElement
                        x="260"
                        y="5"
                        width="80"
                        height="20"
                        forecolor="#FFFFFF"/>
                <textElement textAlignment="Center">
                    <font isBold="true"/>
                </textElement>
                <text><![CDATA[Qty]]></text>
            </staticText>

            <!-- Unit Price -->
            <staticText>
                <reportElement
                        x="345"
                        y="5"
                        width="100"
                        height="20"
                        forecolor="#FFFFFF"/>
                <textElement textAlignment="Right">
                    <font isBold="true"/>
                </textElement>
                <text><![CDATA[Unit Price]]></text>
            </staticText>

            <!-- Total -->
            <staticText>
                <reportElement
                        x="450"
                        y="5"
                        width="100"
                        height="20"
                        forecolor="#FFFFFF"/>
                <textElement textAlignment="Right">
                    <font isBold="true"/>
                </textElement>
                <text><![CDATA[Total]]></text>
            </staticText>

        </band>
    </columnHeader>


    <!-- ====================================================== -->
    <!-- DETAIL: One row for every order item                   -->
    <!-- ====================================================== -->

    <detail>
        <band height="25">

            <!-- Product name -->
            <textField>
                <reportElement x="5" y="3" width="250" height="20"/>
                <textFieldExpression>
                    <![CDATA[$F{productName}]]>
                </textFieldExpression>
            </textField>

            <!-- Quantity -->
            <textField>
                <reportElement x="260" y="3" width="80" height="20"/>
                <textElement textAlignment="Center"/>
                <textFieldExpression>
                    <![CDATA[$F{quantity}]]>
                </textFieldExpression>
            </textField>

            <!-- Unit price -->
            <textField pattern="₹#,##0.00">
                <reportElement x="345" y="3" width="100" height="20"/>
                <textElement textAlignment="Right"/>
                <textFieldExpression>
                    <![CDATA[$F{price}]]>
                </textFieldExpression>
            </textField>

            <!-- Line total -->
            <textField pattern="₹#,##0.00">
                <reportElement x="450" y="3" width="100" height="20"/>
                <textElement textAlignment="Right"/>
                <textFieldExpression>
                    <![CDATA[$F{lineTotal}]]>
                </textFieldExpression>
            </textField>

        </band>
    </detail>


    <!-- ====================================================== -->
    <!-- SUMMARY: Grand total + Thank you                       -->
    <!-- ====================================================== -->

    <summary>
        <band height="80">

            <!-- Horizontal line -->
            <line>
                <reportElement x="0" y="5" width="555" height="1"/>
                <graphicElement>
                    <pen lineWidth="1.5"/>
                </graphicElement>
            </line>

            <!-- TOTAL label -->
            <staticText>
                <reportElement x="350" y="15" width="100" height="25"/>
                <textElement textAlignment="Right">
                    <font size="14" isBold="true"/>
                </textElement>
                <text><![CDATA[TOTAL:]]></text>
            </staticText>

            <!-- Grand total -->
            <textField pattern="₹#,##0.00">
                <reportElement x="455" y="15" width="100" height="25"/>
                <textElement textAlignment="Right">
                    <font size="14" isBold="true"/>
                </textElement>
                <textFieldExpression>
                    <![CDATA[$P{totalAmount}]]>
                </textFieldExpression>
            </textField>

            <!-- Footer message -->
            <staticText>
                <reportElement x="0" y="55" width="555" height="20"/>
                <textElement textAlignment="Center"/>
                <text><![CDATA[Thank you for shopping with ScaleCart!]]></text>
            </staticText>

        </band>
    </summary>

</jasperReport>